# Copy to .env for local use, or add as Environment Variables in your Vercel project settings.
# Create a key in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional - model used by the AI analyst (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Optional - AI requests allowed per client per 10 minutes (default 30)
AI_RATE_LIMIT=30
