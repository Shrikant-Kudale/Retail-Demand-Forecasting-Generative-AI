# Copy to .env for local use, or add as Environment Variables in your Vercel project settings.
# Add ONE key. The provider is detected from the key (xai-... = Grok, AIza... = Gemini).
XAI_API_KEY=
# GEMINI_API_KEY=

# Optional: force the provider ("xai" or "gemini") and/or pin a model id.
# If AI_MODEL is empty the app discovers a suitable model from your key automatically.
AI_PROVIDER=
AI_MODEL=

# Optional - AI requests allowed per client per 10 minutes (default 30)
AI_RATE_LIMIT=30
